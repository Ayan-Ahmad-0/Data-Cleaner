# Google Gemini API Key for AI report and recipe generation
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: DuckDB resource settings
DUCKDB_MEMORY_LIMIT=8GB
DUCKDB_THREADS=4
DUCKDB_TEMP_DIRECTORY=/tmp/duckdb

# Storage Retention & Automated TTL Cleanup Policy
STORAGE_TTL_HOURS=24
STORAGE_CLEANUP_INTERVAL_MINUTES=30
STORAGE_CLEANUP_ENABLED=true
STORAGE_MAX_DISK_PERCENT=90
